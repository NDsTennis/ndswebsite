# Copy this file to .env.local and fill in real values for local development.
# None of the defaults below are real — the app runs and degrades gracefully
# (empty states, disabled forms) with this file left as-is or entirely absent.

# --- Supabase -----------------------------------------------------------
# Public (safe to expose client-side; access is restricted by RLS policies,
# see supabase/migrations/). Leave unset to run without Supabase — the
# Reviews section shows its empty state and both forms show a friendly
# "currently unavailable" message instead of erroring.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Contact --------------------------------------------------------------
# Real values are not finalized yet. Replace with the real inbox and
# WhatsApp number (digits only, international format, no "+" or spaces,
# e.g. "491511234567") when available.
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Social (optional) ------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
